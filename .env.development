# Local development (yarn serve), with the API started locally:
# python3 flask_app.py --config=local  (API served at the root, without /ecco)
VUE_APP_API_URL=http://localhost:5004
VUE_APP_APP_ROOT_URL=/ecco
VUE_APP_APP_URL=http://localhost:9090/ecco

# Set up default collection for non-assigned documents:
VUE_APP_UNSORTED_DOCUMENTS_COLLECTION_TITLE=Hors collections
